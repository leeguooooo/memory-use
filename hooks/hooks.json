{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "MEMORY_USE_NO_UPDATE_CHECK=1 python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/memory_use.py\" hook prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "MEMORY_USE_NO_UPDATE_CHECK=1 python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/memory_use.py\" hook session",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "MEMORY_USE_NO_UPDATE_CHECK=1 python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/memory_use.py\" hook tool",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "MEMORY_USE_NO_UPDATE_CHECK=1 python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/memory_use.py\" hook stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
